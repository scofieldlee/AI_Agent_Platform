# ====================================
# AI Agent Platform - Environment Configuration
# Copy this file to .env and fill in real values
#   cp .env.example .env
# ====================================

# --- Application ---
APP_NAME=AI Agent Platform
DEBUG=True
ENVIRONMENT=development
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32

# --- Database (PostgreSQL + pgvector) ---
# 1. createdb ai_agent_platform
# 2. psql -d ai_agent_platform -c "CREATE EXTENSION IF NOT EXISTS vector;"
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_agent_platform
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/ai_agent_platform

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- DeepSeek (Primary LLM Provider) ---
# Get your key at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Model Configuration ---
CHAT_MODEL=deepseek-chat
CHAT_MODEL_TEMPERATURE=0.3
REASONING_MODEL=deepseek-reasoner
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512

# --- Knowledge Base (optional local path) ---
OBSIDIAN_VAULT_PATH=
CHUNK_SIZE=500
CHUNK_OVERLAP=50
VECTOR_SEARCH_TOP_K=20
RERANK_TOP_K=5
KNOWLEDGE_CONFIDENCE_THRESHOLD=0.75

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- Logging ---
LOG_LEVEL=INFO
